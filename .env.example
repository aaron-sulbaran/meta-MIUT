# Muse (Meta Model API) key from dev.meta.ai. Server side only. Leave empty to use recorded fixtures.
# This is the only required variable.
MUSE_API_KEY=
# Base URL of the Muse API. Default when empty: https://api.meta.ai/v1
MUSE_BASE_URL=
# Model id. Default when empty: muse-spark-1.3. Also: muse-wonder-1.0, muse-ember-1.0 (all read images).
MUSE_MODEL=
# Reasoning effort sent with every call: minimal, low, medium, high, xhigh, or max. Default when empty: low.
MUSE_REASONING_EFFORT=
