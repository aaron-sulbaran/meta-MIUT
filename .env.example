# Muse (Meta Model API) key from dev.meta.ai. Server side only. Leave empty to use recorded fixtures.
# This is the only required variable.
MUSE_API_KEY=
# Base URL of the Muse API. Default when empty: https://api.meta.ai/v1
MUSE_BASE_URL=
# Model id. Default when empty: muse-ember-1.0. Also: muse-spark-1.3, muse-wonder-1.0 (all read images).
MUSE_MODEL=
# Reasoning effort sent with every call: minimal, low, medium, high, xhigh, or max. Default when empty: low.
MUSE_REASONING_EFFORT=
# Shared store: Redis from the Vercel Marketplace. Leave empty to use an in-memory store per server process
# (fine locally; on Vercel a published event may not reach other screens without it).
# The Marketplace integration sets KV_REST_API_URL and KV_REST_API_TOKEN; UPSTASH_REDIS_REST_URL and
# UPSTASH_REDIS_REST_TOKEN also work.
KV_REST_API_URL=
KV_REST_API_TOKEN=
# Token the /demo console needs to reset demo data on the deployed site. Not needed in development.
DEMO_RESET_TOKEN=
